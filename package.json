{
	"name": "black-hole-lab",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "npm run test:unit",
		"verify": "npm run check && npm run lint && npm run test:unit && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/newsreader": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Laboratorio interactivo de relatividad: relojes, órbitas y fotones alrededor de un agujero negro de Schwarzschild.",
	"engines": {
		"node": ">=22.17"
	}
}
